{
  "dependency_check": "warn",
  "modules": {
    "core": {
      "paths": ["src/core/**"],
      "public": ["src/core/index.ts", "src/core/ports/**"],
      "depends_on": [],
      "status": "open"
    },
    "billing": {
      "paths": ["src/billing/**"],
      "public": ["src/billing/index.ts"],
      "depends_on": ["core"],
      "status": "open"
    },
    "promo": {
      "paths": ["src/promo/**"],
      "public": ["src/promo/index.ts"],
      "depends_on": ["core"],
      "status": "open",
      "optional": true,
      "off_test": "tests/promo_off.test.ts"
    },
    "ui": {
      "paths": ["src/ui/**"],
      "depends_on": ["core", "billing"],
      "status": "open"
    }
  }
}
